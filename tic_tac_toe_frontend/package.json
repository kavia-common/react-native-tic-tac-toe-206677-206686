{
  "name": "reactnative",
  "version": "1.0.0",
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "node -e \"const {execSync}=require('node:child_process'); try{execSync('lsof -ti tcp:3000 | xargs -r kill -9',{stdio:'ignore'});}catch(e){}\" && expo start --web --port 3000 --host localhost",
    "lint": "eslint .",
    "prebuild:android": "expo prebuild --platform android",
    "build": "npm run prebuild:android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.4",
    "expo": "~53.0.20",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.0.10",
    "eslint": "^9.33.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.3.0",
    "jiti": "^2.5.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.40.0"
  },
  "private": true
}
